# This file is a template. If `.env` is missing, the integration auto-creates
# `integrations/zatca-einvoicing/.env` on first run (never touches Laravel root `.env`).
# Optional overrides: `.env.local` in the same folder (loaded after `.env`).

# Required for compliance CSID request (from Fatoora / ZATCA sandbox portal)
ZATCA_OTP=

# Compliance endpoint (default: Integration Sandbox as specified for this project)
# Base URL only; CSID path is appended in zatcaService (/complianceCert-api or /compliance for Fatoora).
ZATCA_COMPLIANCE_URL=https://sandbox.zatca.gov.sa/IntegrationSandbox

# CSR source — use ONE of the following strategies:

# A) PEM file on disk (absolute or relative to ZATCA_STORAGE_APP_ROOT)
ZATCA_CSR_FILE_PATH=zatca/einvoice-settings/1/zatca.csr

# B) Laravel storage/app root when CSR is stored by PHP (relative paths in DB)
ZATCA_STORAGE_APP_ROOT=../../storage/app

# C) Inline PEM (CI / secrets manager injection) — overrides file if set
# ZATCA_CSR_PEM="-----BEGIN CERTIFICATE REQUEST-----\n...\n-----END CERTIFICATE REQUEST-----"

# Optional: read csr_path from PostgreSQL (same DB as Laravel)
# ZATCA_DATABASE_URL=postgres://...
# ZATCA_USE_DATABASE_CSR=true

# Where to persist compliance credentials (JSON). Directory created if missing.
ZATCA_CREDENTIALS_STORE_PATH=./storage/zatca/compliance-credentials.json

# HTTP
ZATCA_HTTP_TIMEOUT_MS=120000
