APP_NAME="Akwad System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production (Railway): نفس نطاق التطبيق العام — يصلح روابط livewire.js / Vite عندما يكون APP_URL صحيحاً
# ASSET_URL=https://factory-erp-production.up.railway.app
# اختياري: رابط مطلق لملف Livewire فقط (غالباً اتركه فارغاً واستخدم APP_URL + ASSET_URL)
# LIVEWIRE_ASSET_URL=
#
# Livewire: لا تضع manifest.json تحت public/vendor/livewire على السيرفر إلا إذا رفعت معه كل ملفات JS.
# بدون المجلد بالكامل يظهر خطأ Unexpected token '<' (السيرفر يعيد HTML بدل JS). الأفضل عدم نشر
# livewire:publish --assets والاعتماد على مسار /livewire-xxxxxxxx/livewire.min.js تلقائياً.

# Optional: long random string; enables GET /deploy-prod?token=... and /system-update?token=... (migrate, caches, storage:link). Remove after use.
# SYSTEM_UPDATE_TOKEN=

# --- Railway / production (اضبطها في لوحة Railway Variables) ---
# APP_NAME="Akwad System"
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...          (ثابت بين النشرات؛ أنشئه مرة: php artisan key:generate --show)
# APP_URL=https://your-app.up.railway.app
# DB_CONNECTION=pgsql         (أو mysql حسب قاعدة Railway)
# DATABASE_URL=...            (غالباً يُحقن تلقائياً من Railway Postgres/MySQL)
# أو يدوياً: DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# SESSION_DRIVER=database     (يحتاج جدول sessions بعد migrate)
# SESSION_SECURE_COOKIE=true  (مع HTTPS)
# QUEUE_CONNECTION=database   (إذا استخدمت طوابير)
# CACHE_STORE=database      (أو redis إن وُجد)
# FILESYSTEM_DISK=local      (أو s3 للرفع السحابي)
# LOG_CHANNEL=stderr        (مفيد على Railway)
# MAIL_MAILER=...           (إن أرسلت بريداً)

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# نسبة ضريبة القيمة المضافة الافتراضية (%) — تُستخدم في النماذج والإعدادات المركزية (config/accounting.php)
DEFAULT_VAT_PERCENT=15
# عدد الخانات العشرية لعرض المبالغ والكميات في الواجهات (erp_money / erp_qty)
ERP_MONEY_DECIMALS=2
ERP_QUANTITY_DECIMALS=2

# --- الحضور وربط خصوماته بالرواتب (config/attendance.php) — كلها اختيارية ---
ATTENDANCE_SCHEDULED_START=08:00
ATTENDANCE_GRACE_MINUTES=0
ATTENDANCE_HOURS_PER_WORK_DAY=8
ATTENDANCE_DAYS_PER_MONTH_PAYROLL=30
ATTENDANCE_WORK_HOURS_PER_WEEK=40
ATTENDANCE_WORK_DAYS_PER_WEEK=5

# إجبار روابط التطبيق على HTTPS (مثلاً خلف بروكسي SSL) — اختياري؛ يُقرأ في AppServiceProvider
# FORCE_HTTPS=false

# الموارد البشرية والرواتب: القيم الافتراضية في config/hr.php (ثوابت، بدون مفاتيح .env حالياً).
# رموز مزامنة الحضور عبر API تُدار من جدول attendance_api_tokens (أمر artisan)، وليس من .env.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS (Railway, etc.): إذا ظهر 419 عند تسجيل الدخول، عيّن:
# APP_URL=https://factory-erp-production.up.railway.app
# SESSION_DOMAIN=          (اتركه فارغاً أو احذف المفتاح — لا تضع نطاقاً خاطئاً)
# SESSION_SECURE_COOKIE=true
# ثم: php artisan migrate (جدول sessions مطلوب عند SESSION_DRIVER=database)
# وتأكد أن APP_KEY ثابت في متغيرات Railway ولا يُولَّد من جديد كل نشر.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Clinic: WhatsApp (Meta Cloud API) & Patient Portal ---
# CLINIC_WHATSAPP_ENABLED=false
# CLINIC_WHATSAPP_ACCESS_TOKEN=
# CLINIC_WHATSAPP_PHONE_NUMBER_ID=
# CLINIC_WHATSAPP_API_VERSION=v21.0
# CLINIC_WHATSAPP_DEFAULT_COUNTRY_CODE=20

# Nursery WhatsApp (falls back to CLINIC_* if unset)
# NURSERY_WHATSAPP_ENABLED=false
# NURSERY_WHATSAPP_ACCESS_TOKEN=
# NURSERY_WHATSAPP_PHONE_NUMBER_ID=
# NURSERY_WHATSAPP_DEFAULT_COUNTRY_CODE=966
# NURSERY_PORTAL_OTP_LOG_ONLY=true
# NURSERY_PORTAL_DEV_OTP_CODE=123456
# CLINIC_PORTAL_BOOKING_LOOKAHEAD_DAYS=30
# CLINIC_PORTAL_MANAGE_CUTOFF_HOURS=24

# Online store payment (global defaults — per-tenant keys in إعدادات المتجر)
# APP_URL must be your public HTTPS domain in production (used for Paymob webhook URL).
# STORE_PAYMENT_PROVIDER=paymob
# STORE_PAYMENT_SANDBOX=false
# STORE_DEFAULT_COUNTRY_CODE=EG
# STORE_PAYMOB_WEBHOOK_PATH=/webhooks/store/paymob

# Queues — required in production for WhatsApp/PDF jobs after checkout
# QUEUE_CONNECTION=redis

# Store WhatsApp (falls back to CLINIC_* if unset)
# STORE_WHATSAPP_ENABLED=false
# STORE_WHATSAPP_ACCESS_TOKEN=
# STORE_WHATSAPP_PHONE_NUMBER_ID=
# STORE_WHATSAPP_API_VERSION=v21.0
# STORE_WHATSAPP_DEFAULT_COUNTRY_CODE=966

# Filament panel at /admin: comma-separated user IDs only (log in via main app first).
# If empty, /admin returns 404 for everyone.
FILAMENT_ALLOWED_USER_IDS=
# Logged-in but not allowed: not_found | redirect
FILAMENT_UNAUTHORIZED_RESPONSE=not_found
